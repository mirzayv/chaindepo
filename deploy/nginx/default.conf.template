# ChainDepo nginx config (template).
# The nginx image replaces ${DOMAIN} from the container environment; nginx's own $variables are left as is.
# One certificate covers ${DOMAIN}, www.${DOMAIN} and api.${DOMAIN} (certbot names it after the first -d).

map $http_upgrade $connection_upgrade {
	default upgrade;
	''      close;
}

# HTTP: ACME challenge for renewals, everything else redirects to HTTPS
server {
	listen 80;
	listen [::]:80;
	server_name ${DOMAIN} www.${DOMAIN} api.${DOMAIN};

	location /.well-known/acme-challenge/ {
		root /var/www/certbot;
	}

	location / {
		return 301 https://$host$request_uri;
	}
}

# Frontend: ${DOMAIN}, www.${DOMAIN} -> Next.js
server {
	listen 443 ssl;
	listen [::]:443 ssl;
	http2 on;
	server_name ${DOMAIN} www.${DOMAIN};

	ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
	ssl_protocols TLSv1.2 TLSv1.3;

	location / {
		proxy_pass http://next:3000;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;
	}
}

# API: api.${DOMAIN} -> NestJS (GraphQL + WebSocket on /), uploads from the shared volume
server {
	listen 443 ssl;
	listen [::]:443 ssl;
	http2 on;
	server_name api.${DOMAIN};

	ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
	ssl_protocols TLSv1.2 TLSv1.3;

	# graphql-upload allows up to 10 files x 15MB
	client_max_body_size 150m;

	location /uploads/ {
		alias /var/www/uploads/;
		expires 30d;
		access_log off;
	}

	location / {
		proxy_pass http://api:3007;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;
		# keep idle WebSocket connections open
		proxy_read_timeout 3600s;
		proxy_send_timeout 3600s;
	}
}
